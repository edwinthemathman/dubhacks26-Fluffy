# Placeholder names only. Do not put real keys in git.
# Copy to .env for local runs. The process environment is what the servers read.

PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8100/api/integrations/spotify/callback
SPOTIFY_ARRIVAL_TRACK_URI=spotify:track:REPLACE_WITH_TRACK_ID

PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_SENDER_ID=
# Destination is a Photon space id (pho_spc_...), never a phone number in the model payload.
CAREGIVER_DESTINATION=

# Shared by the harness, executor, and output service. Generated by `fluffy dev` when empty.
FLUFFY_INTERNAL_TOKEN=
