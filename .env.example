# Copy this file to .env in the repository root. Each teammate keeps their own
# .env. Do not commit it. A deployed host should set these variables in its
# secret store instead of shipping this file.
#
# `fluffy dev` loads this file from the repository root, not from the shell's
# current directory. Values already exported in the process environment win.

# Inference. Without a key, typed requests are accepted and then reported as
# not configured. They are not treated as completed actions.
PERCEPTRON_API_KEY=
# Non-secret model name. Example: perceptron-mk1.5
PERCEPTRON_MODEL=

# ElevenLabs. All three values are required before speech is marked configured.
# Configured is not the same as a successful synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Non-secret model id. Example: eleven_flash_v2_5
ELEVENLABS_MODEL_ID=
# Optional alias used only when ELEVENLABS_MODEL_ID is empty.
# ELEVENLABS_MODEL=

# Spotify. Client id does not grant playback. A person still has to sign in
# once in the browser. The live companion stores the refresh token in
# .spotify_token. The output service stores its own copy in
# data/spotify_oauth.json. Both stay on this machine.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Harness output-service callback, when that process owns login instead:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8100/api/integrations/spotify/callback
# Non-secret track URI. Example: spotify:track:your-track-id
SPOTIFY_ARRIVAL_TRACK_URI=

# Photon caregiver messages. The destination is a Photon space id, not a phone
# number, and it is never sent to the model as a tool argument.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_SENDER_ID=
CAREGIVER_DESTINATION=
# Live companion texts. PERSON_PHONE is the person in the room.
PHOTON_FROM=
PHOTON_CAREGIVER_HANDLE=
PERSON_PHONE=

# Shared by the harness, executor, and output service. `fluffy dev` generates
# one for the child processes when this is empty.
FLUFFY_INTERNAL_TOKEN=

# Non-secret local addresses. The defaults below match the laptop demo.
# FLUFFY_HARNESS_HOST=127.0.0.1
# FLUFFY_HARNESS_PORT=8000
# FLUFFY_HOME_HOST=127.0.0.1
# FLUFFY_HOME_PORT=8100
# FLUFFY_SESSION_ID=ses_demo
