# Public, non-secret addresses. Provider keys belong in the repository-root
# .env and are read only by the backend. Do not put them in NEXT_PUBLIC_*.
NEXT_PUBLIC_FLUFFY_HTTP=http://127.0.0.1:8000
NEXT_PUBLIC_FLUFFY_CONTRACT=execution-v2
# Optional override. Defaults to the HTTP origin with ws/wss.
# NEXT_PUBLIC_FLUFFY_WS=ws://127.0.0.1:8000
