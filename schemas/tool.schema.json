        "type": "object",
        "additionalProperties": false,
        "properties": {
          "room": {
            "type": "string",
            "enum": [
              "living_room"
            ]
          },
          "luminosity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "0 is off and 100 is full brightness."
          },
          "light": {
