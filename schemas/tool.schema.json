              {
                "type": "string",
                "enum": [
                  "lamp.living_floor",
                  "light.living_ceiling"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "A light id in the room. Omit for every light."
          }
        },
        "required": [
          "room",
          "luminosity"
        ]
      },
      "model_parameters": {
